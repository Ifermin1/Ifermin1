# Modo del motor: "mock" (simulador, sin NinjaTrader) o "ninja" (puente ZMQ real)
ENGINE_MODE=mock

# Token que la consola web/móvil debe presentar. Cámbialo por uno largo y aleatorio.
API_TOKEN=cambiame

# Dónde escucha la API (0.0.0.0 para exponerla en la LAN / túnel)
API_HOST=0.0.0.0
API_PORT=8000

# Puente ZMQ hacia NinjaTrader (solo ENGINE_MODE=ninja)
ZMQ_HOST=127.0.0.1
ZMQ_MASTER_PORT=5555
ZMQ_FOLLOWER_PORT=5556
ZMQ_SYNC_PORT=5557

DB_PATH=data/tradepilot.db
