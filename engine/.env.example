# Modo del motor: "mock" (simulador, sin NinjaTrader) o "ninja" (puente ZMQ real)
ENGINE_MODE=mock

# Token que la consola web/móvil debe presentar. Cámbialo por uno largo y aleatorio.
API_TOKEN=
# Token de solo lectura (opcional): ver sin poder operar ni cambiar nada. Déjalo vacío si no lo usas.
API_READ_TOKEN=cambiame

# Dónde escucha la API (0.0.0.0 para exponerla en la LAN / túnel)
API_HOST=0.0.0.0
API_PORT=8000
# URL pública fija (opcional). scripts\publish.ps1 la escribe sola en data/public_url.txt al abrir el túnel.
PUBLIC_URL=
# Contacto para los avisos push al teléfono (va en la clave VAPID; cualquier mailto: vale)
PUSH_SUBJECT=mailto:tradepilot@example.com

# Puente ZMQ hacia NinjaTrader (solo ENGINE_MODE=ninja)
ZMQ_HOST=127.0.0.1
ZMQ_MASTER_PORT=5555
ZMQ_FOLLOWER_PORT=5556
ZMQ_SYNC_PORT=5557

DB_PATH=data/tradepilot.db

# Calendario económico y análisis con IA (Claude). Sin clave, los avisos de noticias llevan un análisis por reglas.
# La clave se crea en https://platform.claude.com (API keys). Nunca la subas a Git ni la compartas.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
NEWS_REFRESH_SECONDS=300
NEWS_ALERT_MINUTES=30
NEWS_COUNTRIES=USD
NEWS_MIN_IMPACT=low

# Operar desde la consola (pestaña Operar): contratos máximos por orden y versión mínima del addon
MANUAL_MAX_QTY=20
MANUAL_ADDON_VERSION=2.7

# Trailing stop: revisión por segundo; en modo IA, cada cuánto se consulta a Claude y con qué modelo (vacío = AI_MODEL)
TRAIL_INTERVAL_S=1
AI_TRAIL_INTERVAL_S=60
AI_TRAIL_MODEL=

# Riesgo automático: perfil de prop firm para cuentas nuevas reconocibles por el nombre (APEX…), tope de contratos y colchón
AUTO_RISK=true
AUTO_RISK_FIRM=apex
AUTO_RISK_PLAN=eval
AUTO_RISK_MAX_CONTRACTS=5
AUTO_RISK_BUFFER=250

# Hub (opcional): servidor central que reúne varios engines (ver hub/README.md). Vacío = desactivado.
HUB_URL=
HUB_TOKEN=
HUB_NODE=
HUB_INTERVAL_S=30

# Vigilante: segundos sin addon para declarar modo degradado, sin datos de mercado para avisar, y cada cuánto recordar
WATCHDOG_DEGRADED_AFTER_S=30
WATCHDOG_NO_TICKS_AFTER_S=180
WATCHDOG_REMIND_S=600

# Copias de seguridad de la base de datos en engine\data\backups: cuántas conservar y cada cuántas horas
BACKUP_KEEP=14
BACKUP_INTERVAL_H=24

# Copiloto en vivo (posiciones abiertas): cada cuántos segundos revisa y cada cuánto repite un aviso
COPILOT_INTERVAL_S=300
COPILOT_REMIND_S=1800
